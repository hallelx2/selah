{
  "name": "selah",
  "version": "0.3.0",
  "description": "A Bible for the terminal, with an honest reading tracker",
  "type": "module",
  "private": true,
  "bin": {
    "selah": "src/index.tsx"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "themes": "bun scripts/gen-themes.ts",
    "release": "bun scripts/build.ts --release"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.2",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentui/core": "0.5.16",
    "@opentui/solid": "0.5.16",
    "solid-js": "1.9.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hallelx2/selah"
  }
}
