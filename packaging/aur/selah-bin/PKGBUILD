# Maintainer: hallelx2 <halleluyaholudele@gmail.com>
pkgname=selah-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="A Bible for the terminal: study desk, Matthew Henry, Hebrew and Greek, Doré engravings, Ask your own Claude or Codex, and an honest reading tracker"
arch=('x86_64' 'aarch64')
url="https://github.com/hallelx2/selah"
license=('MIT')
provides=('selah')
conflicts=('selah')
# A Bun-compiled executable carries its app after the ELF sections; stripping destroys it.
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/hallelx2/selah/v$pkgver/LICENSE")
source_x86_64=("selah-$pkgver-x86_64::https://github.com/hallelx2/selah/releases/download/v$pkgver/selah-linux-x64")
source_aarch64=("selah-$pkgver-aarch64::https://github.com/hallelx2/selah/releases/download/v$pkgver/selah-linux-arm64")
sha256sums=('9e37de5278988bdf453acf1055de228e19f2ed4e892cd3bc9b0af1b7491b9b5b')
sha256sums_x86_64=('145c549b1f1f657243f558b01f9d914003f798c4b6d854385d1dd3c77c758233')
sha256sums_aarch64=('e37c4607f72a42215039e16efb6040c273787c159bfc7141c3b2f42acf776df0')

package() {
  install -Dm755 "selah-$pkgver-$CARCH" "$pkgdir/usr/bin/selah"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
